# deployment/systemd/stp-web.service: the public Stock Token Passport site and MCP server (apps/stocks-web.mjs) on
# 127.0.0.1:3005, behind nginx (deployment/nginx/proofofstock.xyz.conf). It runs the release /opt/stp/current points at
# (scripts/deploy.sh). It reads the recorded readings and the impostor files under the two dataset roots. It writes
# one thing: its own visit counter, under /var/lib/stp-analytics (apps/stocks-analytics.mjs).
[Unit]
Description=Stock Token Passport: public site and MCP server (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/stp/current
Environment=STOCKS_WEB_HOST=127.0.0.1
Environment=STOCKS_WEB_PORT=3005
Environment=STOCKS_ROOT_BASE=/var/lib/stp/base
Environment=STOCKS_ROOT_ROBINHOOD=/var/lib/stp/robinhood
Environment=STP_ANALYTICS_DIR=/var/lib/stp-analytics
StateDirectory=stp-analytics
StateDirectoryMode=0700
ExecStart=/usr/bin/node apps/stocks-web.mjs
Restart=on-failure
RestartSec=5s
Nice=5
MemoryAccounting=true
MemoryMax=384M
CPUQuota=50%
NoNewPrivileges=true
# Root only to read the dataset. Its one capability is to READ past file permissions (one dataset directory belongs to
# the collector's own user); it cannot write past them, bind a privileged port, change owners or load anything into
# the kernel. The file system is read-only except its own counter directory.
# Not a dedicated user: that needs group read on the dataset, and one dataset directory is the collector's own, which
# this site must not re-own or re-permission.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
# It sees only its own processes in /proc, and what it writes (the counter files) is readable by root alone.
ProtectProc=invisible
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/stp-analytics
# The recorder's private copies of third-party answers are not the site's to read: the path does not exist for it.
InaccessiblePaths=-/var/lib/stp-raw
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @raw-io @module @debug @cpu-emulation @obsolete
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stp-web

[Install]
WantedBy=multi-user.target
