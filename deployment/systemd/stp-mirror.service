# deployment/systemd/stp-mirror.service: each issuer's token list rebuilt from its factory's events on the chain
# (scripts/stocks/issuer-mirror.mjs), compared with the issuer's API list. Every 15 minutes, 4 minutes of scanning at
# most per chain, so the first backfill spreads over a few runs and then a run costs a call or two. It reads the issuers'
# APIs and public RPCs, and writes only <root>/stock-peg/mirror.json.
[Unit]
OnFailure=stp-alert@%n.service
Description=Stock Token Passport: issuer lists mirrored from the chain, Base and Robinhood

[Service]
Type=oneshot
# The dedicated user pos (deployment/CUTOVER.md), never root. It reads nothing of the token dataset.
User=pos
Group=pos
WorkingDirectory=/opt/stp/current
# "$$rc" is systemd's escape for the shell's "$rc": a bare $rc would be replaced by systemd with an empty value, and the
# unit would never fail.
ExecStart=/bin/sh -c 'rc=0; /usr/bin/node scripts/stocks/issuer-mirror.mjs --chain=base --root=/var/lib/pos/base --budget-s=240 || rc=1; /usr/bin/node scripts/stocks/issuer-mirror.mjs --chain=robinhood --root=/var/lib/pos/robinhood --budget-s=120 || rc=1; exit $$rc'
Nice=10
TimeoutStartSec=8min
NoNewPrivileges=true
# It writes only each chain's stock-peg/ under /var/lib/pos, which StateDirectory creates and gives to pos; the rest of
# the file system is read-only. No capability at all.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
StateDirectory=pos/base/stock-peg pos/robinhood/stock-peg
StateDirectoryMode=0755
# The owner's secrets do not exist for it (systemd itself reads EnvironmentFile= before this applies).
InaccessiblePaths=-/etc/pos -/etc/stp
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
