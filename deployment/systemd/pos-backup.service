# deployment/systemd/pos-backup.service: back up POS's own data, /var/lib/pos, and the daily anchors beside it,
# /var/lib/stp-anchors, with restic, to its own Backblaze B2 bucket over the S3 API (scripts/ops/pos-backup.mjs; setup
# in deployment/BACKUP.md). It writes a status file that stp-health reads: no success for 24 h is an alert, and so is a
# source path that was not there to copy.
# The repository, its password and the storage key come ONLY from /etc/pos/backup.env (root, 0600), which the owner
# writes on the host; the unit is skipped until that file exists. Nothing secret is in git or in this file.
[Unit]
Description=Proof of Stock: back up /var/lib/pos and the anchors (restic)
OnFailure=stp-alert@%n.service
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pos/backup.env

[Service]
Type=oneshot
# Its own user: the site runs as pos and must not be able to read this process's environment (the storage key).
User=pos-backup
Group=pos-backup
WorkingDirectory=/opt/stp/current
EnvironmentFile=/etc/pos/backup.env
# What goes into the copy, absolute paths separated by ":". The data root first; then /var/lib/stp-anchors, whose
# OpenTimestamps proofs are the only thing here that cannot be rebuilt from the data (a proof made later attests the
# day it was made, not the day it covers). A path that is not on the host does not stop the run: it is named in the
# status file, and stp-health alerts on it (backup:sources). Then the two small directories stp-web keeps that nothing
# else holds (27.11): the published agent tests, whose links and badges people put in their READMEs for 30 days, and the
# ledger of paid passes (stp-x402), which people paid for. Both are 0700 for user pos, hence the capability below.
Environment=POS_BACKUP_SOURCE=/var/lib/pos:/var/lib/stp-anchors:/var/lib/stp-agent-test:/var/lib/stp-x402
Environment=POS_BACKUP_STATUS=/var/lib/pos-backup/status.json
Environment=RESTIC_CACHE_DIR=/var/cache/pos-backup
Environment=HOME=/var/lib/pos-backup
# The status file is world-readable on purpose: it holds times, an exit code and any source path that was missing,
# and stp-health (user pos) reads it.
StateDirectory=pos-backup
StateDirectoryMode=0755
CacheDirectory=pos-backup
CacheDirectoryMode=0700
ExecStart=/usr/bin/node scripts/ops/pos-backup.mjs
Nice=19
IOSchedulingClass=idle
MemoryAccounting=true
MemoryMax=1G
CPUQuota=25%
TimeoutStartSec=2h
NoNewPrivileges=true
# /var/lib/pos and /var/lib/stp-anchors are 0644/0755, but /var/lib/stp-agent-test and /var/lib/stp-x402 are 0700 for
# user pos (stp-web's UMask=0077). So it holds CAP_DAC_READ_SEARCH, as stp-health does: read anything, write nothing
# beyond its own state and cache. With it, it could read any root-only file, so the owner's secrets and the password
# files do not exist for it (systemd reads EnvironmentFile= /etc/pos/backup.env before this applies).
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
InaccessiblePaths=-/etc/pos -/etc/stp -/etc/shadow -/etc/gshadow
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @raw-io @module @debug @cpu-emulation @obsolete
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pos-backup
