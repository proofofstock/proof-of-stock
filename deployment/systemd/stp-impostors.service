# deployment/systemd/stp-impostors.service: the impostor list and the names file (scripts/stocks/impostor-list.mjs),
# built from the collector's token-static streams under the dataset roots. Minutes on Robinhood, so low priority.
[Unit]
Description=Stock Token Passport: impostor list, Base and Robinhood

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/stp/current
ExecStart=/bin/sh -c 'rc=0; /usr/bin/node --max-old-space-size=2048 scripts/stocks/impostor-list.mjs --chain=base --root=/var/lib/stp/base || rc=1; /usr/bin/node --max-old-space-size=2048 scripts/stocks/impostor-list.mjs --chain=robinhood --root=/var/lib/stp/robinhood || rc=1; exit $rc'
Nice=19
IOSchedulingClass=idle
MemoryAccounting=true
MemoryMax=2560M
CPUQuota=50%
TimeoutStartSec=40min
NoNewPrivileges=true
# Root only to read the dataset (one root directory belongs to the collector's own user): its one capability is to READ
# past file permissions. It writes only under each chain's stock-peg/ (readings, history, the impostor and names files);
# the rest of the file system, the dataset included, is read-only. Checked on the host on 11.11 with systemd-run and
# these properties: stock-peg/ and history/ writable, the dataset root, /opt/stp and /etc not, static/ readable.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/stp/base/stock-peg /var/lib/stp/robinhood/stock-peg
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @raw-io @module @debug @cpu-emulation @obsolete
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stp-impostors
